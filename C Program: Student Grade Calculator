#include <stdio.h>

int main()
{
    int marks;
    printf("Enter your marks:");
    scanf("%d", & marks);

    if (marks <0 || marks>100)
    {
        printf("invalid marks");
    }
    else if (marks >= 90)
    {
            printf("Your grade is A+");
    }
    else if (marks >= 80)
    {
        printf("Your grade is A");
    }
    else if (marks >= 60)
    {
        printf("Your Grade is B");
    }
    else if (marks >= 50)
    {
        printf("your grade is C");
    }
    else
    {
        printf("You are FAIL");
    }
    return 0;
}
