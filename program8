#include <stdio.h>

int main() {
    int mode;

    printf("Enter Robot Mode (1=Idle, 2=Active, 3=Error): ");
    scanf("%d", &mode);

    switch(mode) {
        case 1:
            printf("Robot is in IDLE mode.\n");
            break;

        case 2:
            printf("Robot is in ACTIVE mode.\n");
            break;

        case 3:
            printf("Robot is in ERROR mode.\n");
            break;

        default:
            printf("Invalid mode selected.\n");
    }

    return 0;
}
