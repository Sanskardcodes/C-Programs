
#include <stdio.h>

#define N 10

float calculateAverage(float distance[], int n)
{
    float sum = 0;

    for (int i = 0; i < n; i++)
    {
        sum = sum + distance[i];
    }

    return sum / n;
}

int main()
{
    float distance[N];
    float nearest;
    int obstacles = 0;

    printf("INTELLIGENT OBSTACLE DETECTION ROBOT\n");

    for (int i = 0; i < N; i++)
    {
        printf("Enter distance reading %d (cm): ", i + 1);
        scanf("%f", &distance[i]);
    }

    nearest = distance[0];

    printf("\n--- DISTANCE SENSOR REPORT ---\n");

    for (int i = 0; i < N; i++)
    {
        printf("Reading %d: %.2f cm", i + 1, distance[i]);

        if (distance[i] < nearest)
        {
            nearest = distance[i];
        }

        if (distance[i] <= 25)
        {
            printf(" - OBSTACLE DETECTED");
            obstacles++;
        }

        printf("\n");
    }

    printf("\n--- FINAL ROBOT REPORT ---\n");

    printf("Average Distance: %.2f cm\n",
           calculateAverage(distance, N));

    printf("Nearest Obstacle: %.2f cm\n", nearest);

    printf("Obstacle Readings: %d\n", obstacles);

    if (obstacles > 0)
    {
        printf("Robot Status: OBSTACLE ALERT\n");
    }
    else
    {
        printf("Robot Status: PATH CLEAR\n");
    }

    return 0;
}
