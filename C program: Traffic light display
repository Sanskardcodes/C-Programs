//Traffic light display using STRCMP

#include<stdio.h>
#include<string.h>

int main()
{
    char traffic_light_color[20];
    printf("Enter traffic light color");
    scanf("%s",traffic_light_color);

    if(strcmp(traffic_light_color, "green")==0)
    {
        printf("You are free to go ");
    }

    else if(strcmp(traffic_light_color, "yellow")==0)
    {
        printf("get ready to drive");
    }

    else
    {
        printf("Stop");
    }

    return 0;
}
