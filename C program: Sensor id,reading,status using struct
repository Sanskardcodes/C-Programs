#include<stdio.h>

    struct sensor{
        int id;
        float reading;
        char status[20];
    };

    int main()
{
    struct sensor s1;

    printf("enter sensor id:");
    scanf("%d",&s1.id);

    printf("Enter sensor reading:");
    scanf("%f",&s1.reading);

    printf("Enter sensor status :ON/OFF");
    scanf("%s",&s1.status);

    //display the data
    printf("\n----Robot sensor details---\n");
    printf("sensor Id:%d\n",s1.id);
    printf("sensor reading:%f\n",s1.reading);
    printf("Sensor status:%s\n",s1.status);
    return 0;
}

