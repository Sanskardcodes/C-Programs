
#include <stdio.h>

int main()
{
    int start, end, i, j, prime;

    printf("Enter starting number: ");
    scanf("%d", &start);

    printf("Enter ending number: ");
    scanf("%d", &end);

    printf("Prime numbers are: ");

    for (i = start; i <= end; i++)
    {
        if (i < 2)
            continue;

        prime = 1;

        for (j = 2; j < i; j++)
        {
            if (i % j == 0)
            {
                prime = 0;
                break;
            }
        }

        if (prime == 1)
        {
            printf("%d ", i);
        }
    }

    return 0;
}
